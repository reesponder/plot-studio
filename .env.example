# Generate a complete local configuration with npm run init.
PORT=14990
PUBLIC_ORIGIN=http://localhost:14990
PLOT_STATE_DIR=.plot-data

# Required. Generate with node outputs/plot-studio/server.mjs hash on stdin.
STUDIO_PASSWORD_HASH=

# Required. Generate a different random 32-byte base64url value for each key.
STUDIO_SESSION_SECRET=
PLOT_PROJECT_STORAGE_KEY=
PLOT_FILE_KEY=

# Optional interpreter paths. On Windows, for example, .venv/Scripts/python.exe.
PLOT_PYTHON=
PLOT_ASSET_PYTHON=
PLOT_PROJECT_STORE_PYTHON=
PLOT_CERTIFICATE_PYTHON=

# Optional private signature image for your own certificate issuer.
PLOT_CERTIFICATE_SIGNATURE=

# Production multi-domain startup is configured separately.
PLOT_STUDIO_ALIAS_ROTATION=0
PLOT_STUDIO_DISTRIBUTED_BOOT=0

# Optional payments and exam delivery. Supply your own provider configuration.
PLOT_STRIPE_SECRET_KEY=
PLOT_STRIPE_PUBLISHABLE_KEY=
PLOT_STRIPE_PRICE_ID=
PLOT_EXAM_STRIPE_WEBHOOK_SECRET=
PLOT_EXAM_ACCESS_SECRET=
PLOT_EXAM_DELIVERY_MODE=manual
PLOT_EXAM_MAIL_HOST=
PLOT_EXAM_MAIL_PORT=
PLOT_EXAM_MAIL_MODE=
PLOT_EXAM_MAIL_FROM=
PLOT_EXAM_MAIL_USERNAME=
PLOT_EXAM_MAIL_PASSWORD=
