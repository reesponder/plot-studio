              "id": "block-41493bfc-fcac-49c2-8bd2-c96a53e9e12c-4w",
              "type": "text",
              "props": {
                "text": "Mara Vale is an independent songwriter and producer. Her recordings combine close-miked voices, tape loops and upright piano. On stage she works with a compact playback setup and keys."
              },
              "style": {},
              "styles": {
                "tablet": {},
                "mobile": {}
              },
              "children": []
