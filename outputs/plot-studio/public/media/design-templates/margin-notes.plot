        {
          "id": "block-87f3ca13-abc7-4931-a85e-7ec96d0bfab9-1p",
          "type": "hero",
          "props": {
            "eyebrow": "",
            "title": "A note on keeping receipts",
            "text": "The first issue of Margin Notes.",
            "buttonText": "",
            "buttonLink": "#",
            "image": "",
            "alt": "",
            "caption": "",
            "layout": "split"
          },
          "style": {
