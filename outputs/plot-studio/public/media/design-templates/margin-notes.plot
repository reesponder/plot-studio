        },
        {
          "id": "block-6f25572e-d07e-4dcd-9420-54505e51779c-1v",
          "type": "section",
          "props": {
            "label": "Essay",
            "anchor": ""
          },
          "style": {
            "maxWidth": 810,
            "justifySelf": "center",
            "paddingInline": "clamp(20px,6.5vw,110px)",
            "paddingBlock": "25px 90px",
            "borderTop": "1px solid #b3a996"
          },
          "styles": {
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "id": "block-e7d4c766-27bf-496e-88a5-2abcf1d752a1-1q",
              "type": "text",
              "props": {
                "text": "My father kept transport receipts in a brown envelope in the kitchen. He wrote a place name across the top corner of each one. After he moved, we found a map of a year in those scribbles."
              },
              "style": {
                "fontSize": 21,
                "lineHeight": "1.6"
              },
              "styles": {
                "tablet": {},
                "mobile": {}
              },
              "children": []
            },
            {
              "id": "block-7243254b-3b1e-43bc-bf7b-566a46c36aed-1r",
              "type": "heading",
              "props": {
                "text": "What the paper remembers",
                "tag": "h2",
                "anchor": ""
              },
              "style": {},
              "styles": {
                "tablet": {},
                "mobile": {}
              },
              "children": []
            },
            {
              "id": "block-0a9b8466-7313-464b-838e-b977f4e5d97c-1s",
              "type": "text",
              "props": {
                "text": "A receipt pins a moment to an ordinary place. There is a corner shop, an early train, the cost of a cup of coffee. Those facts take on weight because nobody intended to save them."
              },
              "style": {
                "fontSize": 19
              },
              "styles": {
                "tablet": {},
                "mobile": {}
              },
              "children": []
            },
            {
              "id": "block-5563a794-c6c1-4cae-bc40-1f91223a29aa-1t",
              "type": "text",
              "props": {
                "text": "I started a new envelope in January. It now holds a museum ticket, a repair slip and a scrap of paper with my neighbour’s recipe. I have written where each one came from."
              },
              "style": {
                "fontSize": 19
              },
              "styles": {
                "tablet": {},
                "mobile": {}
              },
              "children": []
            },
            {
              "id": "block-d93a189e-e509-4121-a3e2-98638a6438be-1u",
              "type": "link",
              "props": {
                "text": "Back to Margin Notes",
                "href": "page:page-7ec54b7b-0987-4397-9f1c-aec9d07acb45-14",
                "newTab": false
              },
              "style": {},
              "styles": {
                "tablet": {},
                "mobile": {}
              },
              "children": []
            }
          ]
        },
