{
  "name": "plot-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted visual website builder, node workflows, Python backend and Paint editor.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "init": "node scripts/init-local.mjs",
    "start": "node --env-file=.env outputs/plot-studio/server.mjs",
    "build": "node outputs/plot-studio/build-studio.mjs",
    "deps": "npm ci --prefix outputs/plot-studio/publish-toolchain --ignore-scripts && npm ci --prefix outputs/plot-studio/studio-build-toolchain --ignore-scripts",
    "test": "node work/check-plot-file-crypto.mjs && node work/check-project-secrets-store.mjs && node work/check-studio-content.mjs",
    "test:paint": "node work/check-paint-engine.mjs && node work/check-paint-editor.cjs",
    "test:startup": "node scripts/test-startup.mjs"
  },
  "devDependencies": { "playwright": "1.65.1" }
}
